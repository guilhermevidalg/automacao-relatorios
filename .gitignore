# Ambiente virtual do Python
.venv/

# Variáveis de ambiente e segredos
.env

# Arquivos temporários do Python
__pycache__/
*.pyc

# Arquivos do macOS
.DS_Store

# Planilhas geradas pelo script (recrie com: python3 src/gerar_dados.py)
data/raw/

# Base limpa gerada pela limpeza (recrie com: python3 src/limpeza.py)
data/processed/

# Relatórios gerados (recrie com: .venv/bin/python src/relatorio.py)
output/

# Arquivos de log gerados ao rodar os scripts
logs/
*.log

# Configurações pessoais do Claude Code
.claude/settings.local.json
