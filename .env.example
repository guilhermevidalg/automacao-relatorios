# Modelo do arquivo de configuração do envio de e-mail (src/email_sender.py).
# Copie para .env e preencha com seus dados:
#     cp .env.example .env
# O .env NUNCA vai para o GitHub (está no .gitignore). Este modelo vai, sem valores reais.

# Conta do Gmail que envia o relatório
GMAIL_REMETENTE=

# Senha de app de 16 letras (NÃO é a senha normal do Gmail).
# Crie em https://myaccount.google.com/apppasswords (exige verificação em duas etapas).
GMAIL_SENHA_APP=

# Quem recebe o relatório; para vários endereços, separe por vírgula
EMAIL_DESTINATARIOS=
